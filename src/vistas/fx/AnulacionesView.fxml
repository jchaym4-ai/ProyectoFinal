<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladorFx.AnulacionesFXController" spacing="13" prefWidth="900" stylesheets="@anulaciones.css" styleClass="anulaciones-root">
    <padding><Insets top="22" right="24" bottom="24" left="24"/></padding>
    <VBox spacing="5" styleClass="anulaciones-cabecera">
        <Label text="Gestión de anulaciones" styleClass="anulaciones-titulo"/>
        <Label text="Consulta todos los boletos, filtra por concierto y anula únicamente entradas sin utilizar." wrapText="true" styleClass="anulaciones-subtitulo"/>
    </VBox>

    <VBox spacing="12" styleClass="anulaciones-panel">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Concierto" styleClass="anulaciones-etiqueta"/>
                <ComboBox fx:id="cmbConciertos" maxWidth="Infinity" prefWidth="340"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Buscar boleto o venta" styleClass="anulaciones-etiqueta"/>
                <TextField fx:id="txtBuscar" promptText="N° boleto, venta, QR, localidad..."/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="9">
            <Button fx:id="btnActualizar" text="Actualizar lista" onAction="#actualizarTabla" styleClass="anulaciones-boton anulaciones-actualizar"/>
            <Button fx:id="btnLimpiar" text="Limpiar filtros" onAction="#limpiarFiltros" styleClass="anulaciones-boton anulaciones-limpiar"/>
            <Label fx:id="lblResumen" text="Cargando boletos..." HBox.hgrow="ALWAYS" styleClass="anulaciones-resumen"/>
        </HBox>
    </VBox>

    <VBox spacing="10" styleClass="anulaciones-panel">
        <Label text="Todos los boletos registrados" styleClass="anulaciones-seccion-titulo"/>
        <TableView fx:id="tablaBoletos" prefHeight="280" minHeight="195" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colBoleto" text="Boleto" prefWidth="70"/>
                <TableColumn fx:id="colVenta" text="Venta" prefWidth="62"/>
                <TableColumn fx:id="colConcierto" text="Concierto" prefWidth="196"/>
                <TableColumn fx:id="colLocalidad" text="Localidad" prefWidth="110"/>
                <TableColumn fx:id="colAsiento" text="Asiento" prefWidth="97"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="105"/>
                <TableColumn fx:id="colPrecio" text="Importe" prefWidth="95"/>
            </columns>
            <placeholder><Label text="No hay boletos que coincidan con el filtro."/></placeholder>
        </TableView>
        <Label fx:id="lblSeleccionado" wrapText="true" text="Selecciona un boleto para revisar su estado." styleClass="anulaciones-seleccionado"/>
    </VBox>

    <VBox spacing="10" styleClass="anulaciones-panel">
        <Label text="Anular boleto o venta completa" styleClass="anulaciones-seccion-titulo"/>
        <TextArea fx:id="txtMotivo" prefRowCount="2" wrapText="true" promptText="Motivo obligatorio (5 a 500 caracteres): ejemplo, compra duplicada."/>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="btnAnularBoleto" text="Anular boleto seleccionado" onAction="#anularBoleto" styleClass="anulaciones-boton anulaciones-anular"/>
            <Button fx:id="btnAnularVenta" text="Anular venta completa" onAction="#anularVenta" styleClass="anulaciones-boton anulaciones-anular-venta"/>
        </HBox>
        <Label text="Los boletos que ya ingresaron o están cancelados no se pueden anular. Una venta completa solo se anula si TODOS sus boletos siguen válidos." wrapText="true" styleClass="anulaciones-ayuda"/>
    </VBox>
    <Label fx:id="lblEstado" wrapText="true" text="Esperando sesión..." styleClass="anulaciones-estado"/>
</VBox>
