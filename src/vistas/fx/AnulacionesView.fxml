<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controladorFx.AnulacionesFXController"
      spacing="13" prefWidth="900" style="-fx-background-color: #F4F7FB;">
    <padding><Insets top="22" right="24" bottom="24" left="24"/></padding>
    <VBox spacing="5">
        <Label text="Gestión de anulaciones" style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
        <Label text="Consulta todos los boletos, filtra por concierto y anula únicamente entradas sin utilizar."
               wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
    </VBox>

    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 17;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Concierto" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                <ComboBox fx:id="cmbConciertos" maxWidth="Infinity" prefWidth="340"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Buscar boleto o venta" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                <TextField fx:id="txtBuscar" promptText="N° boleto, venta, QR, localidad..."/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="9">
            <Button fx:id="btnActualizar" text="Actualizar lista" onAction="#actualizarTabla"
                    style="-fx-background-color: #0D9488; -fx-text-fill: white; -fx-background-radius: 7; -fx-padding: 9 13;"/>
            <Button fx:id="btnLimpiar" text="Limpiar filtros" onAction="#limpiarFiltros"
                    style="-fx-background-color: #E2E8F0; -fx-text-fill: #0F172A; -fx-background-radius: 7; -fx-padding: 9 13;"/>
            <Label fx:id="lblResumen" text="Cargando boletos..." HBox.hgrow="ALWAYS"
                   style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
        </HBox>
    </VBox>

    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15;">
        <Label text="Todos los boletos registrados" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
        <TableView fx:id="tablaBoletos" prefHeight="280" minHeight="195" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colBoleto" text="Boleto" prefWidth="70"/>
                <TableColumn fx:id="colVenta" text="Venta" prefWidth="62"/>
                <TableColumn fx:id="colConcierto" text="Concierto" prefWidth="196"/>
                <TableColumn fx:id="colLocalidad" text="Localidad" prefWidth="110"/>
                <TableColumn fx:id="colAsiento" text="Asiento" prefWidth="97"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="105"/>
                <TableColumn fx:id="colPrecio" text="Importe" prefWidth="95"/>
            </columns>
            <placeholder><Label text="No hay boletos que coincidan con el filtro."/></placeholder>
        </TableView>
        <Label fx:id="lblSeleccionado" wrapText="true"
               text="Selecciona un boleto para revisar su estado."
               style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
    </VBox>

    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
        <Label text="Anular boleto o venta completa" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
        <TextArea fx:id="txtMotivo" prefRowCount="2" wrapText="true"
                  promptText="Motivo obligatorio (5 a 500 caracteres): ejemplo, compra duplicada."/>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="btnAnularBoleto" text="Anular boleto seleccionado" onAction="#anularBoleto"
                    style="-fx-background-color: #B91C1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 14;"/>
            <Button fx:id="btnAnularVenta" text="Anular venta completa" onAction="#anularVenta"
                    style="-fx-background-color: #7F1D1D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 14;"/>
        </HBox>
        <Label text="Los boletos que ya ingresaron o están cancelados no se pueden anular. Una venta completa solo se anula si TODOS sus boletos siguen válidos."
               wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
    </VBox>
    <Label fx:id="lblEstado" wrapText="true" text="Esperando sesión..." style="-fx-text-fill: #334155; -fx-font-size: 12px;"/>
</VBox>
