<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root-admin" stylesheets="@menu-admin.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controladorFx.MenuAdministradorFXController">
   <left>
      <VBox prefWidth="245.0" spacing="5.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="24.0" bottom="24.0" left="17.0" right="17.0" />
         </padding>
         <children>
            <Label alignment="CENTER_LEFT" text="SVB-GUA" styleClass="sidebar-title" prefWidth="210.0" />
            <Label text="CONCIERTOS  /  ADMINISTRACIÓN" styleClass="sidebar-subtitle" prefWidth="210.0" />
            <Separator prefWidth="210.0">
               <VBox.margin><Insets top="16.0" bottom="12.0" /></VBox.margin>
            </Separator>

            <Button fx:id="btnDashboard" mnemonicParsing="false" prefHeight="43.0" prefWidth="210.0" text="Dashboard">
               <styleClass>
                  <String fx:value="menu-button" />
                  <String fx:value="menu-button-active" />
               </styleClass>
            </Button>
            <Button fx:id="btnArtistas" mnemonicParsing="false" prefHeight="43.0" prefWidth="210.0" styleClass="menu-button" text="Artistas" />
            <Button fx:id="btnLocalidades" mnemonicParsing="false" prefHeight="43.0" prefWidth="210.0" styleClass="menu-button" text="Localidades" />
            <Button fx:id="btnConciertos" mnemonicParsing="false" prefHeight="43.0" prefWidth="210.0" styleClass="menu-button" text="Conciertos" />
            <Button fx:id="btnInventario" mnemonicParsing="false" prefHeight="43.0" prefWidth="210.0" styleClass="menu-button" text="Inventario" />
            <Button fx:id="btnUsuarios" mnemonicParsing="false" prefHeight="43.0" prefWidth="210.0" styleClass="menu-button" text="Usuarios" />
            <Separator prefWidth="210.0">
               <VBox.margin><Insets top="12.0" bottom="10.0" /></VBox.margin>
            </Separator>
            <Button fx:id="btnControlAcceso" mnemonicParsing="false" prefHeight="43.0" prefWidth="210.0" styleClass="menu-button" text="Control de acceso" />
            <Button fx:id="btnAnulaciones" mnemonicParsing="false" prefHeight="43.0" prefWidth="210.0" styleClass="menu-button" text="Anulaciones" />
            <Button fx:id="btnReportes" mnemonicParsing="false" prefHeight="43.0" prefWidth="210.0" styleClass="menu-button" text="Reportes" />
         </children>
      </VBox>
   </left>

   <top>
      <HBox alignment="CENTER_RIGHT" prefHeight="67.0" minHeight="67.0" maxHeight="67.0"
            spacing="14.0" styleClass="topbar" BorderPane.alignment="CENTER">
         <padding><Insets top="12.0" bottom="12.0" left="28.0" right="28.0" /></padding>
         <children>
            <Label styleClass="topbar-eyebrow" text="SVB-GUA   /   PANEL DE CONTROL" />
            <Region HBox.hgrow="ALWAYS" />
            <!-- Identidad SVB-GUA junto a la sesion activa -->
            <StackPane styleClass="topbar-logo-frame" prefWidth="76.0" minWidth="76.0" maxWidth="76.0" prefHeight="48.0" minHeight="48.0" maxHeight="48.0">
               <children>
                  <ImageView fitWidth="68.0" fitHeight="44.0" preserveRatio="true" smooth="true" mouseTransparent="true" styleClass="topbar-brand-logo">
                     <image><Image url="@../../imagenes/logo-svb-gua.png" /></image>
                  </ImageView>
               </children>
            </StackPane>
            <Label fx:id="lblNombreUsuario" styleClass="user-label" text="Administrador" />
            <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#cerrarSesion"
                    styleClass="logout-button" text="Cerrar sesión" />
         </children>
      </HBox>
   </top>

   <center>
      <VBox spacing="18.0" styleClass="content-area" BorderPane.alignment="CENTER">
         <padding><Insets top="35.0" bottom="32.0" left="35.0" right="35.0" /></padding>
         <children>
            <Label styleClass="content-eyebrow" text="RESUMEN GENERAL" />
            <Label styleClass="content-title" text="Panel principal" />
            <Label styleClass="content-subtitle"
                   text="Consulta el estado de tu operación y administra tus eventos desde un solo lugar." wrapText="true" />

            <GridPane hgap="19.0" vgap="19.0">
               <VBox.margin><Insets top="10.0" /></VBox.margin>
               <columnConstraints>
                  <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
                  <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <VBox prefHeight="145.0" spacing="14.0" styleClass="dashboard-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="card-title" text="ARTISTAS REGISTRADOS" />
                        <Label fx:id="lblTotalArtistas" styleClass="card-value" text="0" />
                     </children>
                  </VBox>
                  <VBox prefHeight="145.0" spacing="14.0" styleClass="dashboard-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="card-title" text="CONCIERTOS REGISTRADOS" />
                        <Label fx:id="lblTotalConciertos" styleClass="card-value" text="0" />
                     </children>
                  </VBox>
                  <VBox prefHeight="145.0" spacing="14.0" styleClass="dashboard-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="card-title" text="LOCALIDADES" />
                        <Label fx:id="lblTotalLocalidades" styleClass="card-value" text="0" />
                     </children>
                  </VBox>
                  <VBox prefHeight="145.0" spacing="14.0" styleClass="dashboard-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="card-title" text="INVENTARIOS" />
                        <Label fx:id="lblTotalInventario" styleClass="card-value" text="0" />
                     </children>
                  </VBox>
               </children>
            </GridPane>
         </children>
      </VBox>
   </center>
</BorderPane>
