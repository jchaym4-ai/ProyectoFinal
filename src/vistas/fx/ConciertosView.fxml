<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0"
            prefWidth="1100.0"
            styleClass="root-conciertos"
            stylesheets="@conciertos.css"
            xmlns="http://javafx.com/javafx/27"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controladorFx.ConciertosFXController">

    <children>
        <VBox spacing="12.0"
              AnchorPane.topAnchor="22.0"
              AnchorPane.rightAnchor="28.0"
              AnchorPane.bottomAnchor="22.0"
              AnchorPane.leftAnchor="28.0">

            <children>

                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="module-title"
                               text="Gestión de Conciertos">
                            <font>
                                <Font name="System Bold" size="28.0"/>
                            </font>
                        </Label>

                        <Label styleClass="module-subtitle"
                               text="Administra los conciertos registrados en SVB-GUA"/>
                    </children>
                </VBox>

                <VBox spacing="8.0"
                      styleClass="form-card">

                    <padding>
                        <Insets top="16.0"
                                right="16.0"
                                bottom="16.0"
                                left="16.0"/>
                    </padding>

                    <children>

                        <Label styleClass="section-title"
                               text="Datos del concierto"/>

                        <GridPane hgap="16.0"
                                  vgap="6.0">

                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS"
                                                   minWidth="10.0"
                                                   prefWidth="100.0"/>
                                <ColumnConstraints hgrow="ALWAYS"
                                                   minWidth="10.0"
                                                   prefWidth="100.0"/>
                                <ColumnConstraints hgrow="ALWAYS"
                                                   minWidth="10.0"
                                                   prefWidth="100.0"/>
                            </columnConstraints>

                            <rowConstraints>
                                <RowConstraints minHeight="10.0"
                                                prefHeight="30.0"
                                                vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="10.0"
                                                prefHeight="38.0"
                                                vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="10.0"
                                                prefHeight="30.0"
                                                vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="10.0"
                                                prefHeight="38.0"
                                                vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="10.0"
                                                prefHeight="30.0"
                                                vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="10.0"
                                                prefHeight="38.0"
                                                vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="10.0"
                                                prefHeight="30.0"
                                                vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="50.0"
                                                prefHeight="58.0"
                                                vgrow="SOMETIMES"/>
                            </rowConstraints>

                            <children>

                                <Label styleClass="field-label"
                                       text="Artista"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0"/>

                                <Label styleClass="field-label"
                                       text="Título del evento"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"/>

                                <Label styleClass="field-label"
                                       text="Recinto"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="0"/>

                                <ComboBox fx:id="cmbArtista"
                                          maxWidth="Infinity"
                                          prefHeight="38.0"
                                          promptText="Seleccione un artista"
                                          styleClass="concierto-combo"
                                          GridPane.columnIndex="0"
                                          GridPane.rowIndex="1"/>

                                <TextField fx:id="txtTituloEvento"
                                           maxWidth="Infinity"
                                           prefHeight="38.0"
                                           promptText="Ingrese el título del evento"
                                           styleClass="concierto-field"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="1"/>

                                <TextField fx:id="txtRecinto"
                                           maxWidth="Infinity"
                                           prefHeight="38.0"
                                           promptText="Ingrese el recinto"
                                           styleClass="concierto-field"
                                           GridPane.columnIndex="2"
                                           GridPane.rowIndex="1"/>

                                <Label styleClass="field-label"
                                       text="Fecha"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="2"/>

                                <Label styleClass="field-label"
                                       text="Hora concierto"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="2"/>

                                <Label styleClass="field-label"
                                       text="Hora apertura"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="2"/>

                                <DatePicker fx:id="dpFechaConcierto"
                                            maxWidth="Infinity"
                                            prefHeight="38.0"
                                            promptText="Seleccione una fecha"
                                            styleClass="concierto-date"
                                            GridPane.columnIndex="0"
                                            GridPane.rowIndex="3"/>

                                <TextField fx:id="txtHoraConcierto"
                                           maxWidth="Infinity"
                                           prefHeight="38.0"
                                           promptText="HH:mm"
                                           styleClass="concierto-field"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="3"/>

                                <TextField fx:id="txtHoraApertura"
                                           maxWidth="Infinity"
                                           prefHeight="38.0"
                                           promptText="HH:mm (opcional)"
                                           styleClass="concierto-field"
                                           GridPane.columnIndex="2"
                                           GridPane.rowIndex="3"/>

                                <Label styleClass="field-label"
                                       text="Estado"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="4"/>

                                <Label styleClass="field-label"
                                       text="Imagen"
                                       GridPane.columnIndex="1"
                                       GridPane.columnSpan="2"
                                       GridPane.rowIndex="4"/>

                                <ComboBox fx:id="cmbEstado"
                                          maxWidth="Infinity"
                                          prefHeight="38.0"
                                          promptText="Seleccione un estado"
                                          styleClass="concierto-combo"
                                          GridPane.columnIndex="0"
                                          GridPane.rowIndex="5"/>

                                <HBox spacing="8.0"
                                      GridPane.columnIndex="1"
                                      GridPane.columnSpan="2"
                                      GridPane.rowIndex="5">

                                    <children>

                                        <TextField fx:id="txtImagenEvento"
                                                   editable="false"
                                                   maxWidth="Infinity"
                                                   prefHeight="38.0"
                                                   promptText="Ruta de imagen (opcional)"
                                                   styleClass="concierto-field"
                                                   HBox.hgrow="ALWAYS"/>

                                        <Button fx:id="btnSeleccionarImagen"
                                                mnemonicParsing="false"
                                                onAction="#seleccionarImagen"
                                                prefHeight="38.0"
                                                prefWidth="150.0"
                                                text="Seleccionar imagen"
                                                styleClass="image-button"/>
                                    </children>
                                </HBox>

                                <Label styleClass="field-label"
                                       text="Descripción"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="6"/>

                                <Label styleClass="field-label"
                                       text="Información adicional"
                                       GridPane.columnIndex="1"
                                       GridPane.columnSpan="2"
                                       GridPane.rowIndex="6"/>

                                <TextArea fx:id="txtDescripcion"
                                          prefHeight="58.0"
                                          promptText="Descripción opcional"
                                          styleClass="concierto-area"
                                          wrapText="true"
                                          GridPane.columnIndex="0"
                                          GridPane.rowIndex="7"/>

                                <TextArea fx:id="txtInformacionAdicional"
                                          prefHeight="58.0"
                                          promptText="Información adicional opcional"
                                          styleClass="concierto-area"
                                          wrapText="true"
                                          GridPane.columnIndex="1"
                                          GridPane.columnSpan="2"
                                          GridPane.rowIndex="7"/>

                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">

                            <children>

                                <Button fx:id="btnGuardar"
                                        mnemonicParsing="false"
                                        onAction="#guardar"
                                        prefHeight="38.0"
                                        prefWidth="120.0"
                                        text="Guardar">
                                    <styleClass>
                                        <String fx:value="action-button"/>
                                        <String fx:value="save-button"/>
                                    </styleClass>
                                </Button>

                                <Button fx:id="btnActualizar"
                                        mnemonicParsing="false"
                                        onAction="#actualizar"
                                        prefHeight="38.0"
                                        prefWidth="120.0"
                                        text="Actualizar">
                                    <styleClass>
                                        <String fx:value="action-button"/>
                                        <String fx:value="update-button"/>
                                    </styleClass>
                                </Button>

                                <Button fx:id="btnEliminar"
                                        mnemonicParsing="false"
                                        onAction="#eliminar"
                                        prefHeight="38.0"
                                        prefWidth="120.0"
                                        text="Eliminar">
                                    <styleClass>
                                        <String fx:value="action-button"/>
                                        <String fx:value="delete-button"/>
                                    </styleClass>
                                </Button>

                                <Button fx:id="btnLimpiar"
                                        mnemonicParsing="false"
                                        onAction="#limpiar"
                                        prefHeight="38.0"
                                        prefWidth="120.0"
                                        text="Limpiar">
                                    <styleClass>
                                        <String fx:value="action-button"/>
                                        <String fx:value="clear-button"/>
                                    </styleClass>
                                </Button>

                            </children>
                        </HBox>

                    </children>
                </VBox>

                <VBox spacing="10.0"
                      styleClass="table-card"
                      VBox.vgrow="ALWAYS">

                    <padding>
                        <Insets top="16.0"
                                right="16.0"
                                bottom="16.0"
                                left="16.0"/>
                    </padding>

                    <children>

                        <Label styleClass="section-title"
                               text="Conciertos registrados"/>

                        <TableView fx:id="tblConciertos"
                                   minHeight="150.0"
                                   prefHeight="190.0"
                                   styleClass="conciertos-table"
                                   VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn fx:id="colId"
                                             minWidth="55.0"
                                             prefWidth="60.0"
                                             text="ID"/>

                                <TableColumn fx:id="colArtista"
                                             minWidth="120.0"
                                             prefWidth="170.0"
                                             text="Artista"/>

                                <TableColumn fx:id="colEvento"
                                             minWidth="150.0"
                                             prefWidth="220.0"
                                             text="Evento"/>

                                <TableColumn fx:id="colFecha"
                                             minWidth="95.0"
                                             prefWidth="110.0"
                                             text="Fecha"/>

                                <TableColumn fx:id="colHora"
                                             minWidth="75.0"
                                             prefWidth="90.0"
                                             text="Hora"/>

                                <TableColumn fx:id="colRecinto"
                                             minWidth="130.0"
                                             prefWidth="190.0"
                                             text="Recinto"/>

                                <TableColumn fx:id="colEstado"
                                             minWidth="100.0"
                                             prefWidth="120.0"
                                             text="Estado"/>

                            </columns>

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                        </TableView>

                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
