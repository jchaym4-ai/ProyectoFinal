<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <content>
      <BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="950.0" styleClass="nueva-venta-root" stylesheets="@nuevaventa.css">
         <top>
            <VBox alignment="CENTER_LEFT" prefWidth="100.0" spacing="12.0" styleClass="venta-header" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets bottom="20.0" left="20.0" right="25.0" top="20.0" />
               </BorderPane.margin>
               <children>
                  <Label styleClass="venta-titulo" text="Nueva Venta">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
                  <Label styleClass="venta-subtitulo" text="Selecciona un concierto para consultar las localidades disponibles." />
                  <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="200.0" spacing="15.0">
                     <children>
                        <ComboBox fx:id="cmbConciertos" maxWidth="-Infinity" prefHeight="40.0" prefWidth="693.0" promptText="Seleccionar concierto..." styleClass="venta-combo" />
                        <Button fx:id="btnConsultarConcierto" mnemonicParsing="false" prefHeight="40.0" prefWidth="120.0" styleClass="venta-boton" text="Consultar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </top>
         <center>
            <StackPane fx:id="contenedorMapa" prefHeight="150.0" prefWidth="200.0" styleClass="venta-mapa" BorderPane.alignment="CENTER">
               <children>
                  <VBox minWidth="300.0" prefHeight="200.0" prefWidth="300.0" spacing="12.0" styleClass="venta-mapa">
                     <StackPane.margin>
                        <Insets />
                     </StackPane.margin>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <Label styleClass="venta-seccion-titulo" text="Mapa de localidades" />
                        <ScrollPane fx:id="panelMapa" minWidth="0.0" prefHeight="550.0" prefWidth="500.0" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                          <content>
                            <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="650.0" prefWidth="550.0" styleClass="venta-mapa-lienzo" />
                          </content>
                        </ScrollPane>
                     </children>
                  </VBox>
               </children>
               <BorderPane.margin>
                  <Insets right="20.0" />
               </BorderPane.margin>
            </StackPane>
         </center>
         <right>
            <VBox maxHeight="-Infinity" maxWidth="300.0" minWidth="300.0" prefWidth="300.0" spacing="10.0" styleClass="venta-resumen" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label styleClass="venta-seccion-titulo" text="Resumen de compra" />
                  <Separator prefWidth="200.0" styleClass="venta-separador" />
                  <Label styleClass="venta-campo-etiqueta" text="Localidad seleccionada" />
                  <Label fx:id="lblLocalidadSeleccionada" styleClass="venta-campo-valor" text="Sin seleccionar" />
                  <Label styleClass="venta-campo-etiqueta" text="Precio unitario" />
                  <Label fx:id="lblPrecioUnitario" styleClass="venta-valor" text="Q 0.00" />
                  <Label styleClass="venta-campo-etiqueta" text="Disponibilidad" />
                  <Label fx:id="lblDisponibles" styleClass="venta-campo-valor" text="0 boletos" />
                  <Label styleClass="venta-campo-etiqueta" text="Cantidad de boletos (aforo)" />
                  <Spinner fx:id="spnCantidad" styleClass="venta-spinner" />
                  <Label styleClass="venta-campo-etiqueta" text="Asientos seleccionados" />
                  <Label fx:id="lblAsientosSeleccionados" styleClass="venta-campo-valor" text="Ninguno" />
                  <Separator prefWidth="200.0" styleClass="venta-separador" />
                  <HBox alignment="BOTTOM_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <Label styleClass="venta-total-texto" text="Total" />
                        <Region prefHeight="28.0" prefWidth="123.0" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotal" alignment="CENTER_RIGHT" styleClass="venta-total" text="Q 0.00" />
                     </children>
                  </HBox>
                  <Button fx:id="btnConfirmarVenta" mnemonicParsing="false" prefHeight="45.0" prefWidth="240.0" styleClass="venta-boton" text="Confirmar Venta" />
               </children>
            </VBox>
         </right>
      </BorderPane>
   </content>
</ScrollPane>
