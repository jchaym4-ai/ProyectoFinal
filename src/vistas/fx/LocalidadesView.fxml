<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane
        styleClass="root-localidades"
        stylesheets="@localidades.css"
        xmlns="http://javafx.com/javafx/27"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controladorFx.LocalidadesFXController">

    <children>

        <VBox spacing="22.0"
              AnchorPane.topAnchor="30.0"
              AnchorPane.rightAnchor="35.0"
              AnchorPane.bottomAnchor="30.0"
              AnchorPane.leftAnchor="35.0">

            <children>

                <VBox spacing="5.0">

                    <children>

                        <Label
                                styleClass="module-title"
                                text="Gestión de Localidades">

                            <font>
                                <Font name="System Bold" size="30.0"/>
                            </font>

                        </Label>

                        <Label
                                styleClass="module-subtitle"
                                text="Administra las localidades registradas en SVB-GUA">

                            <font>
                                <Font size="15.0"/>
                            </font>

                        </Label>

                    </children>

                </VBox>

                <VBox
                        spacing="12.0"
                        styleClass="form-card">

                    <padding>
                        <Insets
                                top="20.0"
                                right="20.0"
                                bottom="20.0"
                                left="20.0"/>
                    </padding>

                    <children>

                        <Label
                                styleClass="section-title"
                                text="Datos de la localidad"/>

                        <Label
                                styleClass="field-label"
                                text="Nombre de la localidad"/>

                        <TextField
                                fx:id="txtNombre"
                                prefHeight="40.0"
                                promptText="Ingrese el nombre de la localidad"
                                styleClass="localidad-field"/>

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="10.0">

                            <children>

                                <Button
                                        fx:id="btnGuardar"
                                        mnemonicParsing="false"
                                        onAction="#guardar"
                                        prefHeight="38.0"
                                        prefWidth="120.0"
                                        text="Guardar">

                                    <styleClass>
                                        <String fx:value="action-button"/>
                                        <String fx:value="save-button"/>
                                    </styleClass>

                                </Button>

                                <Button
                                        fx:id="btnActualizar"
                                        mnemonicParsing="false"
                                        onAction="#actualizar"
                                        prefHeight="38.0"
                                        prefWidth="120.0"
                                        text="Actualizar">

                                    <styleClass>
                                        <String fx:value="action-button"/>
                                        <String fx:value="update-button"/>
                                    </styleClass>

                                </Button>

                                <Button
                                        fx:id="btnEliminar"
                                        mnemonicParsing="false"
                                        onAction="#eliminar"
                                        prefHeight="38.0"
                                        prefWidth="120.0"
                                        text="Eliminar">

                                    <styleClass>
                                        <String fx:value="action-button"/>
                                        <String fx:value="delete-button"/>
                                    </styleClass>

                                </Button>

                                <Button
                                        fx:id="btnLimpiar"
                                        mnemonicParsing="false"
                                        onAction="#limpiar"
                                        prefHeight="38.0"
                                        prefWidth="120.0"
                                        text="Limpiar">

                                    <styleClass>
                                        <String fx:value="action-button"/>
                                        <String fx:value="clear-button"/>
                                    </styleClass>

                                </Button>

                            </children>

                        </HBox>

                    </children>

                </VBox>

                <VBox
                        spacing="15.0"
                        styleClass="table-card"
                        VBox.vgrow="ALWAYS">

                    <padding>
                        <Insets
                                top="20.0"
                                right="20.0"
                                bottom="20.0"
                                left="20.0"/>
                    </padding>

                    <children>

                        <Label
                                styleClass="section-title"
                                text="Localidades registradas"/>

                        <TableView
                                fx:id="tblLocalidades"
                                prefHeight="330.0"
                                styleClass="localidades-table"
                                VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn
                                        fx:id="colId"
                                        minWidth="120.0"
                                        prefWidth="160.0"
                                        text="ID"/>

                                <TableColumn
                                        fx:id="colNombre"
                                        minWidth="300.0"
                                        prefWidth="700.0"
                                        text="Nombre"/>

                            </columns>

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                        </TableView>

                    </children>

                </VBox>

            </children>

        </VBox>

    </children>

</AnchorPane>