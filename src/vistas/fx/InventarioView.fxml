<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controladorFx.InventarioFXController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            pannable="true"
            prefHeight="650.0"
            prefWidth="900.0"
            stylesheets="@inventario.css">

    <content>
        <VBox minWidth="0.0"
              prefWidth="900.0"
              spacing="15.0"
              styleClass="inventario-root">

            <padding>
                <Insets bottom="25.0"
                        left="25.0"
                        right="25.0"
                        top="25.0"/>
            </padding>

            <children>

                <Label styleClass="page-title"
                       text="Gestión de Inventario"/>

                <Label styleClass="page-subtitle"
                       text="Administra la disponibilidad y los precios de los boletos"/>

                <VBox spacing="15.0"
                      styleClass="form-card">

                    <padding>
                        <Insets bottom="20.0"
                                left="20.0"
                                right="20.0"
                                top="20.0"/>
                    </padding>

                    <children>

                        <Label styleClass="section-title"
                               text="Datos del inventario"/>

                        <GridPane hgap="20.0"
                                  vgap="40.0">

                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES"
                                                   minWidth="10.0"
                                                   prefWidth="100.0"/>
                                <ColumnConstraints hgrow="SOMETIMES"
                                                   minWidth="10.0"
                                                   prefWidth="100.0"/>
                            </columnConstraints>

                            <rowConstraints>
                                <RowConstraints minHeight="10.0"
                                                prefHeight="30.0"
                                                vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="10.0"
                                                prefHeight="30.0"
                                                vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="10.0"
                                                prefHeight="30.0"
                                                vgrow="SOMETIMES"/>
                            </rowConstraints>

                            <children>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label"
                                               text="Concierto"/>
                                        <ComboBox fx:id="cmbConcierto"
                                                  prefHeight="40.0"
                                                  maxWidth="Infinity"
                                                  styleClass="form-combo"/>
                                    </children>
                                </VBox>

                                <VBox spacing="6.0"
                                      GridPane.columnIndex="1">
                                    <children>
                                        <Label styleClass="field-label"
                                               text="Localidad"/>
                                        <ComboBox fx:id="cmbLocalidad"
                                                  prefHeight="40.0"
                                                  maxWidth="Infinity"
                                                  styleClass="form-combo"/>
                                    </children>
                                </VBox>

                                <VBox spacing="6.0"
                                      GridPane.rowIndex="1">
                                    <children>
                                        <Label styleClass="field-label"
                                               text="Precio (Q)"/>
                                        <TextField fx:id="txtPrecio"
                                                   prefHeight="40.0"
                                                   styleClass="form-input"/>
                                    </children>
                                </VBox>

                                <VBox spacing="6.0"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="1">
                                    <children>
                                        <Label styleClass="field-label"
                                               text="Tipo de venta"/>
                                        <ComboBox fx:id="cmbTipoVenta"
                                                  prefHeight="40.0"
                                                  maxWidth="Infinity"
                                                  styleClass="form-combo"/>
                                    </children>
                                </VBox>

                                <VBox spacing="6.0"
                                      GridPane.rowIndex="2">
                                    <children>
                                        <Label styleClass="field-label"
                                               text="Cantidad total"/>
                                        <TextField fx:id="txtCantidadTotal"
                                                   prefHeight="40.0"
                                                   styleClass="form-input"/>
                                    </children>
                                </VBox>

                                <VBox spacing="6.0"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="2">
                                    <children>
                                        <Label styleClass="field-label"
                                               text="Cantidad disponible"/>
                                        <TextField fx:id="txtCantidadDisponible"
                                                   prefHeight="40.0"
                                                   styleClass="form-input"/>
                                    </children>
                                </VBox>

                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_LEFT"
                              spacing="12.0">

                            <children>

                                <Button fx:id="btnGuardar"
                                        mnemonicParsing="false"
                                        onAction="#guardar"
                                        prefHeight="42.0"
                                        prefWidth="115.0"
                                        styleClass="btn-guardar"
                                        text="Guardar"/>

                                <Button fx:id="btnActualizar"
                                        mnemonicParsing="false"
                                        onAction="#actualizar"
                                        prefHeight="42.0"
                                        prefWidth="115.0"
                                        styleClass="btn-actualizar"
                                        text="Actualizar"/>

                                <Button fx:id="btnEliminar"
                                        mnemonicParsing="false"
                                        onAction="#eliminar"
                                        prefHeight="42.0"
                                        prefWidth="115.0"
                                        styleClass="btn-eliminar"
                                        text="Eliminar"/>

                                <Button fx:id="btnLimpiar"
                                        mnemonicParsing="false"
                                        onAction="#limpiar"
                                        prefHeight="42.0"
                                        prefWidth="115.0"
                                        styleClass="btn-limpiar"
                                        text="Limpiar"/>

                            </children>
                        </HBox>

                    </children>
                </VBox>

                <VBox fx:id="panelConfiguracionAsientos"
                      spacing="15.0"
                      disable="true"
                      styleClass="form-card">

                    <padding>
                        <Insets bottom="20.0"
                                left="20.0"
                                right="20.0"
                                top="20.0"/>
                    </padding>

                    <children>

                        <Label styleClass="section-title"
                               text="Configuración de asientos numerados"/>

                        <Label wrapText="true"
                               styleClass="page-subtitle"
                               text="Selecciona un inventario numerado de la tabla para generar sus filas y asientos."/>

                        <GridPane hgap="20.0"
                                  vgap="15.0">

                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS"
                                                   minWidth="10.0"/>
                                <ColumnConstraints hgrow="ALWAYS"
                                                   minWidth="10.0"/>
                            </columnConstraints>

                            <children>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label"
                                               text="Capacidad del inventario"/>
                                        <Label fx:id="lblCapacidadAsientos"
                                               text="Seleccione un inventario"
                                               wrapText="true"/>
                                    </children>
                                </VBox>

                                <VBox spacing="6.0"
                                      GridPane.columnIndex="1">
                                    <children>
                                        <Label styleClass="field-label"
                                               text="Asientos por fila"/>
                                        <TextField fx:id="txtAsientosPorFila"
                                                   prefHeight="40.0"
                                                   promptText="Ejemplo: 20"
                                                   styleClass="form-input"/>
                                    </children>
                                </VBox>

                            </children>
                        </GridPane>

                        <Label fx:id="lblEstadoAsientos"
                               text="Todavía no se ha seleccionado un inventario numerado."
                               wrapText="true"/>

                        <HBox alignment="CENTER_LEFT"
                              spacing="12.0">
                            <children>
                                <Button fx:id="btnGenerarAsientos"
                                        mnemonicParsing="false"
                                        prefHeight="42.0"
                                        prefWidth="180.0"
                                        styleClass="btn-guardar"
                                        text="Generar asientos"/>
                            </children>
                        </HBox>

                    </children>
                </VBox>

                <Label styleClass="section-title"
                       text="Inventario registrado"/>

                <TextField fx:id="txtBuscar"
                           promptText="Buscar inventario..."
                           styleClass="search-input"/>

                <TableView fx:id="tablaInventario"
                           prefHeight="240.0"
                           minHeight="220.0"
                           styleClass="inventario-table">

                    <columns>

                        <TableColumn fx:id="colIdInventario"
                                     prefWidth="75.0"
                                     text="ID"/>

                        <TableColumn fx:id="colConcierto"
                                     prefWidth="160.0"
                                     text="Concierto"/>

                        <TableColumn fx:id="colLocalidad"
                                     prefWidth="110.0"
                                     text="Localidad"/>

                        <TableColumn fx:id="colPrecio"
                                     prefWidth="110.0"
                                     text="Precio (Q)"/>

                        <TableColumn fx:id="colCantidadTotal"
                                     prefWidth="90.0"
                                     text="Total"/>

                        <TableColumn fx:id="colCantidadDisponible"
                                     prefWidth="100.0"
                                     text="Disponible"/>

                        <TableColumn fx:id="colTipoVenta"
                                     prefWidth="120.0"
                                     text="Tipo de venta"/>

                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                </TableView>

            </children>
        </VBox>
    </content>
</ScrollPane>
