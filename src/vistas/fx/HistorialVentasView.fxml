<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- SVB-GUA: Vista de Historial de Ventas. Sin controlador por ahora. -->

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="680.0" prefWidth="980.0" styleClass="history-scroll" stylesheets="@historial-ventas.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladorFx.HistorialVentasFXController">
    <content>
        <VBox spacing="20.0" styleClass="history-root">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="28.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="page-title" text="Historial de Ventas" />
                                <Label styleClass="page-subtitle" text="Consulta y búsqueda de ventas registradas" />
                            </children>
                        </VBox>
                        <Label styleClass="read-only-tag" text="SOLO CONSULTA" />
                    </children>
                </HBox>

                <VBox spacing="15.0" styleClass="panel-card">
                    <children>
                        <Label styleClass="section-title" text="Buscar y filtrar" />
                        <HBox alignment="BOTTOM_LEFT" spacing="13.0">
                            <children>
                                <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="field-title" text="N.º de venta o texto de búsqueda" />
                                        <TextField fx:id="txtBuscar" prefHeight="38.0" promptText="Buscar venta, vendedor o concierto" styleClass="filter-field" />
                                    </children>
                                </VBox>
                                <VBox spacing="7.0">
                                    <children>
                                        <Label styleClass="field-title" text="Desde" />
                                        <DatePicker fx:id="dpFechaDesde" prefHeight="38.0" prefWidth="155.0" />
                                    </children>
                                </VBox>
                                <VBox spacing="7.0">
                                    <children>
                                        <Label styleClass="field-title" text="Hasta" />
                                        <DatePicker fx:id="dpFechaHasta" prefHeight="38.0" prefWidth="155.0" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnLimpiar" disable="true" styleClass="secondary-button" text="Limpiar filtros" />
                                <Button fx:id="btnBuscar" disable="true" styleClass="primary-button" text="Buscar ventas" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="12.0" styleClass="panel-card">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="section-title" text="Ventas registradas" />
                                        <Label styleClass="section-subtitle" text="Selecciona una venta para consultar su detalle" />
                                    </children>
                                </VBox>
                                <Label fx:id="lblCantidadResultados" styleClass="counter-tag" text="Sin cargar" />
                            </children>
                        </HBox>
                        <TableView fx:id="tablaHistorial" prefHeight="262.0" styleClass="history-table">
                            <columns>
                                <TableColumn fx:id="colIdVenta" prefWidth="108.0" text="N.º VENTA" />
                                <TableColumn fx:id="colFecha" prefWidth="175.0" text="FECHA Y HORA" />
                                <TableColumn fx:id="colVendedor" prefWidth="182.0" text="VENDEDOR" />
                                <TableColumn fx:id="colCantidadBoletos" prefWidth="92.0" text="BOLETOS" />
                                <TableColumn fx:id="colTotal" prefWidth="132.0" text="TOTAL (Q)" />
                            </columns>
                            <placeholder>
                                <Label styleClass="empty-label" text="No hay ventas cargadas todavía." />
                            </placeholder>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="status-dot" text="●" />
                                <Label fx:id="lblEstadoHistorial" styleClass="status-text" text="Vista lista. Pendiente de conectar las consultas PostgreSQL." />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="12.0" styleClass="panel-card">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="section-title" text="Detalle de la venta" />
                                        <Label styleClass="section-subtitle" text="Consulta del concierto, localidades y boletos asociados" />
                                    </children>
                                </VBox>
                                <Button fx:id="btnVerBoletos" disable="true" styleClass="secondary-button" text="Consultar boletos" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="detail-bar">
                            <children>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="field-title" text="VENTA" />
                                        <Label fx:id="lblDetalleVenta" styleClass="detail-value" text="—" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="field-title" text="VENDEDOR" />
                                        <Label fx:id="lblDetalleVendedor" styleClass="detail-value" text="—" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="field-title" text="TOTAL (Q)" />
                                        <Label fx:id="lblDetalleTotal" styleClass="detail-value" text="—" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Label styleClass="field-title" text="Artículos incluidos en la venta" />
                        <TableView fx:id="tablaDetalleVenta" prefHeight="167.0" styleClass="history-table">
                            <columns>
                                <TableColumn fx:id="colConcierto" prefWidth="232.0" text="CONCIERTO" />
                                <TableColumn fx:id="colLocalidad" prefWidth="156.0" text="LOCALIDAD" />
                                <TableColumn fx:id="colCantidadDetalle" prefWidth="78.0" text="CANT." />
                                <TableColumn fx:id="colPrecioUnitario" prefWidth="114.0" text="PRECIO (Q)" />
                                <TableColumn fx:id="colSubtotal" prefWidth="130.0" text="SUBTOTAL (Q)" />
                            </columns>
                            <placeholder>
                                <Label styleClass="empty-label" text="Selecciona una venta para ver sus artículos." />
                            </placeholder>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
