<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="580.0" prefWidth="900.0" spacing="20.0" styleClass="artistas-root" stylesheets="@artistas.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controladorFx.ArtistasFXController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Label styleClass="page-title" text="Gestión de Artistas" />
      <Label styleClass="page-subtitle" text="Administra los artistas registrados en el sistema" />
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0" styleClass="form-card">
         <children>
            <Label styleClass="section-title" text="Datos del artista" />
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="15.0">
               <children>
                  <VBox prefHeight="200.0" prefWidth="200.0" spacing="6.0">
                     <children>
                        <Label text="Nombre artístico" />
                        <TextField fx:id="txtNombreArtistico" promptText="Ingrese nombre artístico" styleClass="form-input" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="200.0" spacing="6.0">
                     <children>
                        <Label text="Género musical" />
                        <TextField fx:id="txtGeneroMusical" promptText="Ingrese género musical" styleClass="form-input" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="200.0" spacing="6.0">
                     <children>
                        <Label text="País de origen" />
                        <TextField fx:id="txtPaisOrigen" promptText="Ingrese país de origen" styleClass="form-input" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="12.0">
                     <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" styleClass="btn-guardar" text="Guardar" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizar" styleClass="btn-actualizar" text="Actualizar" />
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminar" styleClass="btn-eliminar" text="Eliminar" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar" styleClass="btn-limpiar" text="Limpiar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
      <Label styleClass="section-title" text="Artistas registrados" />
      <TextField fx:id="txtBuscar" prefWidth="350.0" promptText="Buscar artista...." styleClass="search-input" />
      <TableView fx:id="tablaArtistas" prefHeight="350.0" prefWidth="350.0" styleClass="artistas-table" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colNombreArtistico" prefWidth="75.0" text="Nombre artístico" />
            <TableColumn fx:id="colGeneroMusical" prefWidth="75.0" text="Género musical" />
            <TableColumn fx:id="colPaisOrigen" editable="false" prefWidth="75.0" text="País de origen" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
